# Database
DATABASE_URL=postgresql://user:password@localhost:5432/yourreserve

# GRS API
GRS_CLIENT_TOKEN=your_grs_token_here
GRS_HOST_URL=https://api.grs.ir

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ZarinPal Payment Gateway
ZARINPAL_MERCHANT_ID=your_merchant_id
ZARINPAL_SANDBOX=true

# Kavenegar SMS
KAVENEGAR_API_KEY=your_kavenegar_key
KAVENEGAR_SENDER=your_sender_number

# Resend Email
RESEND_API_KEY=your_resend_key

# Upstash Redis (Optional - for caching)
UPSTASH_REDIS_URL=https://your-redis-url
UPSTASH_REDIS_TOKEN=your_token

# App Configuration
NEXT_PUBLIC_APP_NAME=یورزرو
NEXT_PUBLIC_APP_URL=http://localhost:3000
